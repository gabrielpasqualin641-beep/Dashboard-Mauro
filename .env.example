# Mesmas chaves dos Secrets do repositório (Settings › Secrets and variables › Actions).
# Copie para .env.local (fora do Git) para rodar `npm run coletar` na sua máquina.

# Meta (versão fixada no workflow)
META_API_VERSION=v27.0
META_ACCESS_TOKEN=
META_AD_ACCOUNT_BR=
META_AD_ACCOUNT_US=

# Hotmart
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=

# Senha da dashboard (criptografa os dados publicados)
DASHBOARD_PASSWORD=
# Texto aleatório longo para o hash dos compradores (cruzamento Express → 2.0)
SALT_HASH=

USD_BRL_FALLBACK=5.40
